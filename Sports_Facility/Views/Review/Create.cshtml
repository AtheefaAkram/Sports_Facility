@model ReviewCreateViewModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Leave a Review";
}

<h2 style="color:#1F2839;">Review: @Model.FacilitySummary</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post" style="max-width:400px;">
    <input type="hidden" asp-for="BookingId" />

    <div class="mb-3">
        <label asp-for="Rating" class="form-label">Rating (1-5)</label>
        <input asp-for="Rating" type="number" min="1" max="5" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Comment" class="form-label"></label>
        <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn-booknow" style="border:none;">Submit Review</button>
</form>