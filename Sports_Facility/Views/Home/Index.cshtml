@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <div class="hero-eyebrow">YOUR CITY. YOUR SPORT. YOUR COMMUNITY.</div>
    <h1 class="hero-title">MAKING SPORT MORE<br />ACCESSIBLE TO EVERYONE</h1>
    <p class="hero-subtext">Discover and book the perfect sport facility in your community with ease.</p>
</div>

<div class="program-section">
    <h2 class="text-center mb-4">Community Sports Programs</h2>
    <div class="program-grid">

        <div class="program-card">
            <div class="program-card-photo" style="background-image: url('/images/program-basketball.jpg')">
                <span class="program-badge">Weekends</span>
            </div>
            <div class="program-card-body">
                <div class="program-card-title">Basketball Match for Teens</div>
                <p class="program-card-desc">Fast-paced 5-a-side games for ages 13-17. Build skills, teamwork, and confidence on the court.</p>
            </div>
        </div>

        <div class="program-card">
            <div class="program-card-photo" style="background-image: url('/images/program-football.jpg')">
                <span class="program-badge">Weekly</span>
            </div>
            <div class="program-card-body">
                <div class="program-card-title">Soccer League for Adults</div>
                <p class="program-card-desc">An 11-a-side league for players 18 and over. All skill levels welcome.</p>
            </div>
        </div>

        <div class="program-card">
            <div class="program-card-photo" style="background-image: url('/images/program-hockey.jpg')">
                <span class="program-badge">Summer</span>
            </div>
            <div class="program-card-body">
                <div class="program-card-title">Summer Hockey Program for Kids</div>
                <p class="program-card-desc">Introducing ages 6-12 to hockey fundamentals in a fun, supportive summer environment.</p>
            </div>
        </div>
        <div class="program-card">
            <div class="program-card-photo" style="background-image: url('/images/program-tennis-women.jpg')">
                <span class="program-badge">Weekly</span>
            </div>
            <div class="program-card-body">
                <div class="program-card-title">Tennis Course for Women</div>
                <p class="program-card-desc">A dedicated tennis programme for women of all levels, building skills and confidence in a supportive group setting.</p>
            </div>
        </div>
    </div>
</div>