@model Sports_Facility.Models.Facility
@{
    ViewData["Title"] = "Delete Facility";
}

<h2>Delete Facility</h2>
<p>Are you sure you want to delete this facility?</p>

<dl>
    <dt>Name</dt>
    <dd>@Model.FacilityName</dd>
    <dt>Sport</dt>
    <dd>@Model.Sport?.SportName</dd>
    <dt>Location</dt>
    <dd>@Model.Location?.LocationName</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="FacilityId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
