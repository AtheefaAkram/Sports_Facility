@model FacilitySearchViewModel
@{
    Layout = "_GuestLayout";
    ViewData["Title"] = "Browse Facilities";
    var allReviews = ViewBag.Reviews as List<Review>;
}

<h1 style="font-size:24px;font-weight:700;color:#1F2839;margin-bottom:4px;">Browse Facilities</h1>
<p style="color:#3A4553;margin-bottom:18px;">Sign in as a member to book a slot</p>

<div style="display:flex;gap:10px;margin-bottom:20px;">
    <a class="btn-booknow" asp-controller="Guest" asp-action="BecomeMember">Become a Member</a>
    <a class="btn-outline-navy" asp-controller="Guest" asp-action="SendInquiry">Send Inquiry</a>
</div>

<div style="margin-bottom:12px;">
    <a class="filter-pill @(Model.SportId == null ? "active" : "")"
       asp-action="Dashboard" asp-route-SportId="" asp-route-LocationId="@Model.LocationId">All</a>
    @foreach (var sport in Model.Sports)
    {
        <a class="filter-pill @(Model.SportId == sport.SportId ? "active" : "")"
           asp-action="Dashboard" asp-route-SportId="@sport.SportId" asp-route-LocationId="@Model.LocationId">@sport.SportName</a>
    }
</div>

<form asp-action="Dashboard" method="get" style="display:flex;gap:10px;margin-bottom:20px;align-items:flex-end;">
    <input type="hidden" name="SportId" value="@Model.SportId" />

    <div style="min-width:180px;">
        <div style="font-size:11px;color:#8a8f98;margin-bottom:4px;">Location</div>
        <select name="LocationId" class="form-select">
            <option value="">Any</option>
            @foreach (var loc in Model.Locations)
            {
                <option value="@loc.LocationId" selected="@(Model.LocationId == loc.LocationId)">@loc.LocationName</option>
            }
        </select>
    </div>

    <button type="submit" class="btn-booknow" style="border:none;">Search</button>
</form>

<p style="font-size:12px;color:#8a8f98;margin-bottom:10px;">@Model.Results.Count facilities</p>

<div style="display:flex;flex-direction:column;gap:12px;margin-bottom:40px;">
    @foreach (var facility in Model.Results)
    {
        <div class="facility-card">
            <div class="facility-photo" style="background-image: url('/images/facilities/facility-@(facility.FacilityId).jpg')"></div>
            <div style="flex:1;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
                <div>
                    <div class="facility-tag">@facility.Sport?.SportName?.ToUpper()</div>
                    <div style="font-size:15px;font-weight:700;color:#1F2839;margin:2px 0;">@facility.FacilityName</div>
                    <div style="font-size:12px;color:#8a8f98;">@facility.Location?.LocationName</div>
                </div>
                <a class="btn-outline-navy" href="#reviews-@facility.FacilityId">View Reviews</a>
            </div>
        </div>
    }
</div>

<hr />

@foreach (var facility in Model.Results)
{
    <div id="reviews-@facility.FacilityId" style="margin-bottom:30px;">
        <h3 style="font-size:18px;color:#1F2839;">@facility.FacilityName - Reviews</h3>
        @{
            var facilityReviews = allReviews?.Where(r => r.Booking?.FacilityId == facility.FacilityId).ToList();
        }
        @if (facilityReviews == null || !facilityReviews.Any())
        {
            <p style="color:#8a8f98;font-size:13px;">No reviews yet for this facility.</p>
        }
        else
        {
            foreach (var review in facilityReviews)
            {
                <div class="facility-card" style="padding:12px 16px;margin-bottom:10px;">
                    <div>
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                            <span style="color:#B69D74;font-weight:700;font-size:14px;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <text>★</text>
                                    }
                                    else
                                    {
                                        <text>☆</text>
                                    }
                                }
                            </span>
                            <span style="font-size:12px;color:#8a8f98;">@review.Rating / 5</span>
                        </div>
                        <p style="margin:0;color:#3A4553;font-size:13px;">@review.Comment</p>
                    </div>
                </div>
            }
        }
    </div>
}